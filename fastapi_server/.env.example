# 복사해서 .env 로 쓰고 값을 채운다. .env 는 커밋 금지.
# FastAPI와 MySQL이 같은 PC(192.168.1.147)에 있으므로 DB_HOST는 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=equipment_db

# 쉼표로 구분. 비워두면 아래 기본값 사용
CORS_ORIGINS=https://tpm.aitkorea.app,https://aitech6471.github.io,https://aitmt6471.github.io

# 푸시 알람 (비워두면 푸시만 건너뜀)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ait.com
PUSH_URL=https://tpm.aitkorea.app/report.html

# 사진 업로드 (비워두면 photo/* 가 501 반환)
# OAuth 토큰 파일(token.json). 최초 1회 발급 방법은 README 참고
GOOGLE_TOKEN_FILE=
DRIVE_FOLDER_EQUIP=
DRIVE_FOLDER_PARTS=
DRIVE_FOLDER_SUB=
